# Line endings: every text file is stored and checked out with LF, on Windows too, so a build made here and
# the one GitHub Actions makes are byte-identical (the service worker's precache revisions and the WebP
# bake's SVG sha1s then match between the computer and the server).
* text=auto eol=lf

# Art and sound are binary: never converted, never diffed. (SVGs are the art's source: their exact bytes
# are hashed in public/assets/images/webp/sources.json, so they are kept byte for byte too.)
*.svg binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.ogg binary
*.mp3 binary
*.wav binary
*.woff binary
*.woff2 binary
